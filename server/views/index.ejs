<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>HOME</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7" crossorigin="anonymous">
  </head>
  <body>
        <%-include ('menu.html') %>
        <p></p>
        <div class="container input-group ml-2 my-3">
          <input class="form-control sword" type="search" placeholder="검색어 입력">
          <button class="btn btn-success input-group-append sbtn">검색하기</button> </input>
        </div>

    <h1>홈입니다.</h1>

    <% if (user) { %>
      <p>반가워요! <%= user.userid %>님!</p>
      <a href = "/logout">로그아웃</a>
      <% } else { %>
      <h3>로그인 해주세요.</h3>
      <p></p>
      <button class="w-100 btn btn-warning login"><b>로그인</b></button>
      <p></p>
      <button class="w-100 btn btn-success signup"><b>회원가입</b></button>
      <% }%>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js" integrity="sha384-k6d4wzSIapyDyv1kpU366/PK5hCdSbCRGRCMv+eplOQJWyd1fbcAu9OCUj5zNLiq" crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-1.12.4.min.js"></script>
    <script>
      $('.login').click(function(e){
        location.href="/login";
      })

      $('.signup').click(function(e){
        location.href="/signup";
      })

      $('.sbtn').click(function(){
          let inputValue = $('.sword').val();
          location.href = '/search?value=' + inputValue;
        })

    </script>
  
  </body>
</html>